# Application
PROJECT_NAME=Company Management System
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
# Use a dedicated role. See README "PostgreSQL setup" for creation SQL.
DATABASE_URL=postgresql+psycopg://company_app:change-me-strong-password@localhost:5432/company_management

# CORS
# JSON array of allowed origins (no wildcard in production).
CORS_ORIGINS=["http://localhost:3000"]

# Authentication (used from Phase 2 onwards)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development seed credentials (ignored when ENVIRONMENT=production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
